# Copy this file to /opt/qintelipass/.env and fill values on the server.
# Keep the real .env outside Git.
SPRING_PROFILES_ACTIVE=prod
TZ=Asia/Shanghai
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=7510

DATABASE_URL=jdbc:mysql://127.0.0.1:3306/Qzhipass
DATABASE_USERNAME=qintelipass
DATABASE_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_CONNECT_TIMEOUT=2s
REDIS_TIMEOUT=2s

JWT_SECRET=
CORS_ALLOWED_ORIGINS=https://qzhipass.example.com
# Comma-separated numeric user IDs; empty disables all /api/v1/admin endpoints.
ADMIN_USER_IDS=

AI_CONNECT_TIMEOUT=5s
AI_READ_TIMEOUT=120s

APP_HOME=/opt/qintelipass
JAR_PATH=/opt/qintelipass/Qintelipass-0.0.1-SNAPSHOT.jar
JAVA_OPTS=-Duser.timezone=Asia/Shanghai -Xms256m -Xmx512m
